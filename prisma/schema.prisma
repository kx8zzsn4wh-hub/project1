generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum ContentKind {
  problem
  wiki
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  passwordHash String?
  role      UserRole  @default(user)
  createdAt DateTime  @default(now())

  sessions  Session[]
  posts     Post[]    @relation("PostAuthor")
  ownedContents ContentOwnership[]
  createdTags Tag[] @relation("TagCreator")
}

model Session {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id    String @id
  name  String

  posts Post[]
}

model Post {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([channelId])
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  slug        String
  depth       Int
  path        String   @unique
  parentId    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Tag?     @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Tag[]    @relation("TagHierarchy")
  createdBy   User?    @relation("TagCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contentTags ContentTag[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([depth])
}

model ContentOwnership {
  id        String      @id @default(cuid())
  kind      ContentKind
  slug      String
  ownerId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contentTags ContentTag[]

  @@unique([kind, slug])
  @@index([ownerId])
}

model ContentTag {
  id                 String   @id @default(cuid())
  contentOwnershipId String
  tagId              String
  createdAt          DateTime @default(now())

  contentOwnership ContentOwnership @relation(fields: [contentOwnershipId], references: [id], onDelete: Cascade)
  tag              Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentOwnershipId, tagId])
  @@index([tagId])
}
